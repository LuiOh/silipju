# 모두 선택 사항이다. 비워 두면 통근시간은 역·노선 기반 추정치, 실거래가는 샘플 데이터로 동작한다.
# 키는 앱 상단의 API 설정 화면에서도 넣을 수 있다. 화면에서 저장한 값이 여기 값보다 먼저 쓰이고 서버를 다시 띄울 필요도 없다.
# 이 파일로 쓰려면 .env.local 로 복사해서 값을 채운 뒤 dev 서버를 다시 띄운다.

# TMAP 대중교통·자동차 경로(SK open API, https://openapi.sk.com). 대중교통 무료 10건/일이라 매물 상세에서 버튼을 누를 때만 호출한다.
TMAP_APP_KEY=

# 카카오 로컬 REST 키(직장 주소·장소 검색 정확도 향상, https://developers.kakao.com)
KAKAO_REST_API_KEY=

# 국토교통부 아파트 매매·전월세 실거래가 서비스키(Decoding 키). 두 데이터셋 모두 활용신청한다.
# 매매 https://www.data.go.kr/data/15126468/openapi.do · 전월세 https://www.data.go.kr/data/15126474/openapi.do
MOLIT_SERVICE_KEY=

# 금융감독원 금융상품 한눈에 오픈 API 인증키(은행 주담대 현행 금리 자동 반영, https://finlife.fss.or.kr/finlife/main/contents.do?menuNo=700029)
FINLIFE_API_KEY=
